# MoodTune AI - Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/moodtune_ai

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN_DAYS=7

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000
